# Course site: build with `bundle exec jekyll build` (or `serve`) from learn/.
source "https://rubygems.org"

gem "jekyll", "~> 4.4.1"
gem "webrick", "~> 1.9"          # jekyll serve on Ruby 3+

platforms :windows, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
  gem "wdm", ">= 0.1.0"           # file watching for jekyll serve on Windows
end
